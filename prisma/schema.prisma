generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER & AUTHENTICATION
// ==========================================

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id                Int       @id @default(autoincrement())
  role              UserRole  @default(USER)
  email             String    @unique
  name              String?
  password          String?
  updated_at        DateTime  @updatedAt
  created_at        DateTime  @default(now())
  email_verified_at DateTime?

  creditBalance Int @default(0)
  creditWelcomeGranted Boolean @default(false)
  creditsBlocked Boolean @default(false)
  creditTransactions CreditTransaction[]
  creditPurchases CreditPurchase[]

  authSessions AuthSession[]
  identities AuthIdentity[]
  projects   Project[]
  scripts    Script[]

  // Audio Studio
  audioStories      AudioStory[]
  audioJobs         AudioGenerationJob[]
  analysisJobs      StoryAnalysisJob[]
  animationProjects AnimationProject[]
}

model PendingRegistration {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  password_hash String
  otp_hash      String
  expires_at    DateTime
  attempt_count Int       @default(0)
  last_sent_at  DateTime?
  send_count    Int       @default(0)
  window_start  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model AuthIdentity {
  id                Int      @id @default(autoincrement())
  userId            Int
  provider          String
  providerAccountId String
  created_at        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

// ==========================================
// EXISTING PROJECTS
// ==========================================

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  userId      Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scripts ProjectScript[]

  @@index([userId])
}

model Script {
  id         Int      @id @default(autoincrement())
  title      String
  content    String   @default("")
  userId     Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects ProjectScript[]

  @@index([userId])
}

model ProjectScript {
  projectId Int
  scriptId  Int

  sortOrder Int      @default(0)
  added_at  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@id([projectId, scriptId])
  @@index([scriptId])
}

// ==========================================
// AUDIO STUDIO - STORY
// ==========================================

model AudioStory {
  id                Int                 @id @default(autoincrement())
  title             String
  content           String              @default("")
  userId            Int
  status            String              @default("DRAFT")
  analysisStatus    AudioAnalysisStatus @default(PENDING)
  analysisError     String?
  analyzed_at       DateTime?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  analysisResult    Json?
  analyzedAt        DateTime?
  analysisStartedAt DateTime?
  analysisAttemptId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  characters   AudioCharacter[]
  scenes       AudioScene[]
  jobs         AudioGenerationJob[]
  assets       AudioAsset[]
  analysisJobs StoryAnalysisJob[]

  @@index([userId])
}

// ==========================================
// AUDIO STUDIO - CHARACTERS
// ==========================================

model AudioCharacter {
  id         Int      @id @default(autoincrement())
  storyId    Int
  name       String
  gender     String?
  voiceId    Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  story AudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  voice Voice? @relation(fields: [voiceId], references: [id], onDelete: SetNull)

  scenes AudioScene[]

  @@unique([storyId, name])
  @@unique([id, storyId])
  @@index([voiceId])
}

// ==========================================
// AUDIO STUDIO - SCENES
// ==========================================

model AudioScene {
  id              Int      @id @default(autoincrement())
  storyId         Int
  characterId     Int?
  sceneOrder      Int
  externalSceneId String?
  title           String?
  speakerName     String?
  text            String
  language        String   @default("hi")
  emotion         String?
  style           String?
  voiceOverrideId Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  story AudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  character AudioCharacter? @relation(fields: [characterId, storyId], references: [id, storyId], onDelete: NoAction, onUpdate: Cascade)

  voiceOverride Voice? @relation("SceneVoiceOverride", fields: [voiceOverrideId], references: [id], onDelete: SetNull)

  audios   SceneAudio[]
  jobItems AudioGenerationJobItem[]

  @@unique([storyId, sceneOrder])
  @@unique([id, storyId])
  @@index([characterId, storyId])
  @@index([voiceOverrideId])
}

// ==========================================
// UNIFIED VOICE LIBRARY
// ==========================================

model Voice {
  id              Int     @id @default(autoincrement())
  name            String
  displayName     String?
  provider        String
  providerVoiceId String
  model           String

  gender      String?
  ageCategory String?
  description String?
  previewUrl  String?

  isActive   Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  characters     AudioCharacter[]
  sceneAudios    SceneAudio[]
  sceneOverrides AudioScene[]     @relation("SceneVoiceOverride")

  @@unique([provider, providerVoiceId])
  @@index([provider])
  @@index([isActive])
}

// ==========================================
// AUDIO GENERATION JOBS
// ==========================================

model AudioGenerationJob {
  id              Int            @id @default(autoincrement())
  storyId         Int
  userId          Int
  status          AudioJobStatus @default(PENDING)
  totalScenes     Int            @default(0)
  completedScenes Int            @default(0)
  failedScenes    Int            @default(0)
  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  story AudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items AudioGenerationJobItem[]

  @@unique([id, storyId])
  @@index([storyId])
  @@index([userId, status])
}

// ==========================================
// INDIVIDUAL SCENE GENERATION TASKS
// ==========================================

model AudioGenerationJobItem {
  id               Int                @id @default(autoincrement())
  jobId            Int
  sceneId          Int
  storyId          Int
  status           AudioJobItemStatus @default(PENDING)
  attempts         Int                @default(0)
  error            String?
  textSnapshot     String?
  voiceIdSnapshot  Int?
  settingsSnapshot Json?
  nextRetryAt      DateTime?
  lastErrorAt      DateTime?
  started_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  job AudioGenerationJob @relation(fields: [jobId, storyId], references: [id, storyId], onDelete: Cascade)

  scene AudioScene @relation(fields: [sceneId, storyId], references: [id, storyId], onDelete: NoAction)

  audio SceneAudio?

  @@unique([jobId, sceneId])
  @@index([status, nextRetryAt])
  @@index([sceneId, storyId])
}

// ==========================================
// GENERATED SCENE AUDIO
// ==========================================

model SceneAudio {
  id               Int      @id @default(autoincrement())
  sceneId          Int
  jobItemId        Int?     @unique
  voiceId          Int
  provider         String
  providerVoiceId  String
  model            String
  textSnapshot     String
  settingsSnapshot Json?
  filePath         String
  format           String   @default("wav")
  durationMs       Int?
  created_at       DateTime @default(now())
  fileSizeBytes    BigInt?
  mimeType         String?

  scene AudioScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  voice Voice @relation(fields: [voiceId], references: [id], onDelete: Restrict)

  jobItem AudioGenerationJobItem? @relation(fields: [jobItemId], references: [id], onDelete: SetNull)

  @@index([sceneId])
  @@index([voiceId])
}

// ==========================================
// MERGED / EXPORTED AUDIO ASSETS
// ==========================================

model AudioAsset {
  id            Int      @id @default(autoincrement())
  storyId       Int
  type          String
  filePath      String
  format        String   @default("wav")
  durationMs    Int?
  created_at    DateTime @default(now())
  fileSizeBytes BigInt?
  mimeType      String?

  story AudioStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
}

enum AudioAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AudioJobStatus {
  PENDING
  PROCESSING
  WAITING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum AudioJobItemStatus {
  PENDING
  PROCESSING
  WAITING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

// Animation Studio (isolated from Audio Studio)
model AnimationProject {
  id        Int              @id @default(autoincrement())
  userId    Int
  name      String
  width     Int              @default(1920)
  height    Int              @default(1080)
  fps       Int              @default(24)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes    AnimationScene[]

  @@index([userId])
}

model AnimationScene {
  id         Int              @id @default(autoincrement())
  projectId  Int
  name       String
  sortOrder  Int              @default(0)
  durationMs Int              @default(5000)
  canvasData Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  project    AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

// Durable analysis work and shared provider-usage accounting.
enum StoryAnalysisJobStatus {
  QUEUED
  PROCESSING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model StoryAnalysisJob {
  id              String                 @id @default(uuid())
  storyId         Int
  userId          Int
  contentHash     String
  contentSnapshot String
  status          StoryAnalysisJobStatus @default(QUEUED)
  attempts        Int                    @default(0)
  nextRetryAt     DateTime?
  leaseToken      String?
  leaseExpiresAt  DateTime?
  errorCode       String?
  errorMessage    String?
  source          String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  completedAt     DateTime?
  story           AudioStory             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([userId, status])
  @@index([storyId, createdAt])
}

model AiUsageBucket {
  key       String   @id
  requests  Int      @default(0)
  units     Int      @default(0)
  expiresAt DateTime
}

model AiRequestLease {
  id        String   @id @default(uuid())
  userId    Int
  kind      String
  expiresAt DateTime

  @@index([expiresAt])
  @@index([userId, expiresAt])
}

// Revocable, independent browser sessions for the user app and admin dashboard.
model AuthSession {
  id String @id @default(uuid())
  userId Int
  realm String
  refreshHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, realm])
  @@index([expiresAt])
}

model AuthRateBucket {
  key String @id
  attempts Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

// Immutable role-change records; IDs/emails are snapshots, retained if accounts are removed.
model AdminRoleAudit {
  id Int @id @default(autoincrement())
  actorId Int?
  actorEmail String?
  targetId Int
  targetEmail String
  action String
  fromRole UserRole
  toRole UserRole
  reason String
  createdAt DateTime @default(now())
  @@index([targetId, id])
}

// Non-secret configuration only. Provider keys are encrypted in ProviderCredential, never in public appConfig.
model Configuration {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ProviderCredential {
  id          String   @id @default(uuid())
  provider    String
  name        String
  encrypted   String
  fingerprint String
  suffix      String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@unique([provider, fingerprint])
  @@index([provider, enabled])
}

// Ledger references make reservations, refunds, grants and payment credits idempotent.
model CreditTransaction {
  id String @id @default(uuid())
  userId Int
  reference String @unique
  amount Int
  type String
  status String
  reason String
  actorId Int?
  storyId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt, id])
}
model CreditPack {
  id String @id @default(uuid())
  name String
  credits Int
  amountPaise Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CreditPurchase {
  id String @id @default(uuid())
  userId Int
  requestId String
  packId String
  packName String
  credits Int
  amountPaise Int
  currency String @default("INR")
  providerKeyId String
  orderId String? @unique
  paymentId String? @unique
  status String @default("CREATING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, requestId])
  @@index([userId, createdAt])
}
