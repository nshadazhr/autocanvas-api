DATABASE_URL="database-url"
JWT_SECRET="replace-with-your-own-random-secret"
RESEND_API_KEY=re_your_api_key_here
JWT_REFRESH_SECRET=your-refresh-secret-key,
PORT='insert-port-number-here'
NODE_ENV=your-environment-here

# One server-only environment key per provider. No dashboard key management.
GEMINI_API_KEY=
OPENAI_API_KEY=
# No GEMINI_API_KEYS, GEMINI_MULTI_KEY_ENABLED or per-key quota variables are used.

# Razorpay: server only. Leave disabled until test-mode checkout and webhooks are verified.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage writer: local (development), supabase (sandbox), r2 (production).
# Historical reads still use their saved provider; retain credentials for old assets.
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=autocanvas-assets
# R2 is optional unless writing/reading r2:// assets. All values stay server-only.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STORAGE_BUCKET=autocanvas-assets

# Cleanup enablement is managed by Super Admin in Storage settings.
