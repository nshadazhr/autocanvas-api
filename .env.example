# apps/backend is a separate Node process (like apps/worker) — it does NOT
# read apps/web's .env.local. Copy the matching values from the root
# .env.example here.

# Needed to talk to the same database as apps/web / apps/worker.
DATABASE_URL=""

# Needed to enqueue audio generation/export jobs (same Redis as apps/worker).
REDIS_URL=""

# MUST be the exact same value as apps/web's AUTH_SECRET — this is what lets
# apps/backend verify the short-lived bridge token apps/web mints for every
# server-to-server call (see packages/auth/src/bridge-token.ts). If these
# don't match, every request gets a 401.
AUTH_SECRET=""

# AI provider keys, needed here now (not in apps/web) since audio generation
# cost estimation moved into this process. See root .env.example for the
# full per-provider list.
ELEVENLABS_API_KEY=""
OPENAI_API_KEY=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
GOOGLE_TTS_CREDENTIALS_JSON=""

# Storage (R2 / S3-compatible; MinIO locally) — needed here now for signed
# playback/download URLs.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="platform-dev"
STORAGE_ACCESS_KEY_ID="platform"
STORAGE_SECRET_ACCESS_KEY="platform123"
STORAGE_PUBLIC_BASE_URL=""

# Port this HTTP server listens on. apps/web's BACKEND_URL must point here.
PORT="4000"

# Only apps/web's origin should ever call this API directly from a browser
# context; server-to-server calls (the only calls that exist today) aren't
# subject to CORS at all, but this is set up now for when a browser-facing
# endpoint is added later.
FRONTEND_URL="http://localhost:3000"
